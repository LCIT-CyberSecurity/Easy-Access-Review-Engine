# Copy to .env before starting the integration stack.
# Never commit the populated .env file.
AURORA_SESSION_SECRET=replace-with-a-random-long-session-secret
AURORA_ADMIN_USERNAME=admin
AURORA_ADMIN_PASSWORD=SecretPassword
# Use 1 only when the WebUI is served over HTTPS.
AURORA_COOKIE_SECURE=0

# Optional OpenLDAP collector example values. Replace for the integration environment.
AURORA_LDAP_URI=ldaps://ldap.example.test
AURORA_BASE_DN=dc=example,dc=test
AURORA_PROVIDER_NAME=openldap-example
AURORA_BIND_DN=cn=readonly,dc=example,dc=test
AURORA_LDAP_PASSWORD=change-me-example-only
# AURORA_LDAP_PASSWORD_FILE=/run/secrets/openldap-bind-password
# AURORA_LDAP_CA_CERT=/etc/ssl/certs/example-ca.pem
AURORA_START_TLS=0
AURORA_ALLOW_ANONYMOUS=0
AURORA_ALLOW_PARTIAL=0
AURORA_PAGE_SIZE=1000
AURORA_CONNECTION_TIMEOUT_SECONDS=10
AURORA_SEARCH_TIMEOUT_SECONDS=120
AURORA_COMMAND_TIMEOUT_SECONDS=180
AURORA_SEARCH_SCOPE=sub
# Aurora Product Assistant
AURORA_CHATBOT_ENABLED=false
AURORA_CHATBOT_PROVIDER=openai
AURORA_OPENAI_API_KEY=
AURORA_OPENAI_MODEL=
AURORA_CHATBOT_TIMEOUT=20
AURORA_CHATBOT_MAX_OUTPUT_TOKENS=800
AURORA_CHATBOT_MAX_TOOL_ROUNDS=3
AURORA_CHATBOT_MAX_TOOL_CALLS=6
AURORA_CHATBOT_MAX_MESSAGE_CHARS=8000
AURORA_CHATBOT_MAX_HISTORY_MESSAGES=12
AURORA_CHATBOT_MAX_CONTEXT_CHARS=24000
AURORA_CHATBOT_MAX_RESULT_ITEMS=100
AURORA_CHATBOT_STORE_MESSAGE_CONTENT=true
AURORA_CHATBOT_LOG_CONVERSATIONS=true
AURORA_CHATBOT_LOG_TOOL_CALLS=true
AURORA_CHATBOT_TRACE_RETENTION_DAYS=30
# Functional Guardrails are persisted by the ADMIN UI in system_settings;
# provider infrastructure and secrets remain environment-only.
