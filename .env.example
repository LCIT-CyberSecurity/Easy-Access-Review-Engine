# OpenLDAP remote collector example values only.
LDAP_URI=ldaps://ldap.example.test
BASE_DN=dc=example,dc=test
PROVIDER_NAME=openldap-example
BIND_DN=cn=readonly,dc=example,dc=test
LDAP_PASSWORD=change-me-example-only
# LDAP_PASSWORD_FILE=/run/secrets/openldap-bind-password
# LDAP_CA_CERT=/etc/ssl/certs/example-ca.pem
START_TLS=0
ALLOW_ANONYMOUS=0
ALLOW_PARTIAL=0
PAGE_SIZE=1000
CONNECTION_TIMEOUT_SECONDS=10
SEARCH_TIMEOUT_SECONDS=120
COMMAND_TIMEOUT_SECONDS=180
SEARCH_SCOPE=sub
