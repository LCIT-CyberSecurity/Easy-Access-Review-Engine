# Copy to .env before starting the integration stack.
# Never commit the populated .env file.
EARE_SESSION_SECRET=replace-with-a-random-long-session-secret
EARE_ADMIN_USERNAME=admin
EARE_ADMIN_PASSWORD=SecretPassword
# Use 1 only when the WebUI is served over HTTPS.
EARE_COOKIE_SECURE=0

# Optional OpenLDAP collector example values. Replace for the integration environment.
LDAP_URI=ldaps://ldap.example.test
BASE_DN=dc=example,dc=test
PROVIDER_NAME=openldap-example
BIND_DN=cn=readonly,dc=example,dc=test
LDAP_PASSWORD=change-me-example-only
# LDAP_PASSWORD_FILE=/run/secrets/openldap-bind-password
# LDAP_CA_CERT=/etc/ssl/certs/example-ca.pem
START_TLS=0
ALLOW_ANONYMOUS=0
ALLOW_PARTIAL=0
PAGE_SIZE=1000
CONNECTION_TIMEOUT_SECONDS=10
SEARCH_TIMEOUT_SECONDS=120
COMMAND_TIMEOUT_SECONDS=180
SEARCH_SCOPE=sub
# EARE Product Assistant
EARE_CHATBOT_ENABLED=false
EARE_CHATBOT_PROVIDER=openai
EARE_OPENAI_API_KEY=
EARE_OPENAI_MODEL=
EARE_CHATBOT_TIMEOUT=20
EARE_CHATBOT_MAX_OUTPUT_TOKENS=800
EARE_CHATBOT_MAX_TOOL_ROUNDS=3
EARE_CHATBOT_MAX_TOOL_CALLS=6
EARE_CHATBOT_MAX_MESSAGE_CHARS=8000
EARE_CHATBOT_MAX_HISTORY_MESSAGES=12
EARE_CHATBOT_MAX_CONTEXT_CHARS=24000
EARE_CHATBOT_MAX_RESULT_ITEMS=100
EARE_CHATBOT_STORE_MESSAGE_CONTENT=true
EARE_CHATBOT_LOG_CONVERSATIONS=true
EARE_CHATBOT_LOG_TOOL_CALLS=true
EARE_CHATBOT_TRACE_RETENTION_DAYS=30
# Functional Guardrails are persisted by the ADMIN UI in system_settings;
# provider infrastructure and secrets remain environment-only.
