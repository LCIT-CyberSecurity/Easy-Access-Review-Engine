# Copy to .env before starting the integration stack.
# Never commit the populated .env file.
EARE_SESSION_SECRET=replace-with-a-random-long-session-secret
EARE_ADMIN_USERNAME=admin
EARE_ADMIN_PASSWORD=replace-with-a-random-password-at-least-12-characters
# Use 1 only when the WebUI is served over HTTPS.
EARE_COOKIE_SECURE=0

# Optional OpenLDAP collector example values. Replace for the integration environment.
LDAP_URI=ldaps://ldap.example.test
BASE_DN=dc=example,dc=test
PROVIDER_NAME=openldap-example
BIND_DN=cn=readonly,dc=example,dc=test
LDAP_PASSWORD=change-me-example-only
# LDAP_PASSWORD_FILE=/run/secrets/openldap-bind-password
# LDAP_CA_CERT=/etc/ssl/certs/example-ca.pem
START_TLS=0
ALLOW_ANONYMOUS=0
ALLOW_PARTIAL=0
PAGE_SIZE=1000
CONNECTION_TIMEOUT_SECONDS=10
SEARCH_TIMEOUT_SECONDS=120
COMMAND_TIMEOUT_SECONDS=180
SEARCH_SCOPE=sub
